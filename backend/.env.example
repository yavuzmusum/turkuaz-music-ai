# TURKUAZ AI CORE - environment config
# Bu dosyayi .env olarak kopyala ve degerleri doldur

# JWT icin rastgele, uzun ve gizli bir string
SECRET_KEY=change-this-to-a-long-random-secret

# Hugging Face Inference API token (ucretsiz hesap: https://huggingface.co/settings/tokens)
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Kullanilacak muzik uretim modeli (ucretsiz, acik kaynak)
MUSICGEN_MODEL=facebook/musicgen-small

# Veritabani (varsayilan: yerel SQLite dosyasi)
DATABASE_URL=sqlite:///./turkuaz.db

# Uretilen ses dosyalarinin kaydedilecegi klasor
MEDIA_DIR=./media

# Admin hesabi ilk kurulumda otomatik olusturulsun mu
BOOTSTRAP_ADMIN_EMAIL=admin@turkuaz.ai
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
